             <property name="styleSheet">
              <string notr="true">QPushButton {
    background-color: #e0e0e0;  /* Светло-серый фон для обычного состояния */
    color: #000000;             /* Чёрный текст */
    border: none;               /* Без границ */
    border-radius: 4px;         /* Скруглённые углы */
    padding: 8px 16px;          /* Внутренние отступы */
    font-size: 14px;            /* Размер текста */
    font-weight: 500;           /* Средняя толщина текста */
    text-transform: uppercase;  /* Заглавные буквы */
    transition: background-color 0.3s ease; /* Плавный переход цвета */
}

QPushButton:hover {
    background-color: #d6d6d6;  /* Более тёмный серый при наведении */
}

QPushButton:checked {
    background-color: #6200ee;  /* Основной цвет для активного состояния */
    color: white;               /* Белый текст */
    border-radius: 4px;         /* Скруглённые углы остаются */
}

QPushButton:checked:hover {
    background-color: #3700b3;  /* Тёмно-фиолетовый при наведении в активном состоянии */
}

QPushButton:pressed {
    background-color: #bdbdbd;  /* Цвет нажатия */
}

QPushButton:checked:pressed {
    background-color: #2a0080;  /* Более тёмный оттенок в активном состоянии при нажатии */
}
</string>
